# Ambiente exclusivamente local. Copie para .env.test.local com:
# npm run test:env:setup
BLING_RUNTIME_ENV=local_test
BLING_TEST_ENV_CONFIRMED=LOCAL_TEST_DATABASE

# Projeto Supabase exclusivo para testes. NUNCA use aqui o projeto de producao.
SUPABASE_URL=https://SEU-PROJETO-TESTE.supabase.co
SUPABASE_PROJECT_ID=SEU_PROJECT_ID_TESTE
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://SEU-PROJETO-TESTE.supabase.co
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID_TESTE
VITE_SUPABASE_PUBLISHABLE_KEY=

# Use um tunel HTTPS (por exemplo, o seu tunel local) para callback OAuth e workers.
# APP_RETURN_URL pode continuar apontando para a interface local.
APP_PUBLIC_URL=https://SEU-TUNEL-HTTPS
APP_RETURN_URL=http://localhost:8080
BLING_REDIRECT_BASE_URL=https://SEU-TUNEL-HTTPS
BLING_WORKER_SECRET=

# Opcionais: usados somente por npm run test:companies:sync para copiar apenas
# os cadastros das empresas. Credenciais, tokens, produtos e filas nao sao copiados.
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=
TEST_ADMIN_EMAIL=
